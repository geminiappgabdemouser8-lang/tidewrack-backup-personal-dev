; Engine configuration file.
; Godot 4.x project — Tidewrack
; UI and levels are built in code, so scene files stay minimal.

config_version=5

[application]

config/name="Tidewrack"
config/description="A narrative adventure set on a fog-bound island off the Washington coast. You are the new keeper of Cape Marrow Light. The last keeper vanished."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
Journal="*res://scripts/autoload/journal.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]

; Input map for the public demo. Overriding a built-in ui_* action in this file
; REPLACES its default event list, so the keyboard defaults must be listed here
; explicitly alongside the gamepad events — otherwise the demo is pad-only.
; Keyboard: Enter / KP-Enter / Space, Esc, arrow keys.  Gamepad: A, B, left stick.
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]
}
ui_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
ui_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
ui_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
ui_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

[global]

; Steam Next Fest demo build — feature-frozen for the public demo (2026-08).
demo_build=true
